async function generateSHA256(){

const data =
new TextEncoder()
.encode(
document.getElementById(
"hashText"
).value
);

const hash =
await crypto.subtle.digest(
"SHA-256",
data
);

const hex =
[...new Uint8Array(hash)]
.map(
b=>b.toString(16).padStart(2,"0")
)
.join("");

setResult(
"hashResult",
hex,
"success"
);

}


