function convertToRoman(){

let n =
Number(
document.getElementById(
"romanNumber"
).value
);

if(
!Number.isInteger(n) ||
n<1 ||
n>3999
){

showToast(
"Enter a number from 1 to 3999",
"!"
);

return;

}

const values=[
[1000,"M"],
[900,"CM"],
[500,"D"],
[400,"CD"],
[100,"C"],
[90,"XC"],
[50,"L"],
[40,"XL"],
[10,"X"],
[9,"IX"],
[5,"V"],
[4,"IV"],
[1,"I"]
];

let result="";

for(
const [v,s]
of values
){

while(n>=v){

result+=s;
n-=v;

}

}

setResult(
"romanResult",
result,
"success"
);

}


