function calculateAge(){

const value =
document.getElementById(
"birthDate"
).value;

if(!value){

showToast(
"Select your birth date",
"!"
);

return;

}

const birth =
new Date(
value+"T00:00:00"
);

const today =
new Date();

let years =
today.getFullYear()-
birth.getFullYear();

let months =
today.getMonth()-
birth.getMonth();

let days =
today.getDate()-
birth.getDate();

if(days<0){

months--;

days +=
new Date(
today.getFullYear(),
today.getMonth(),
0
).getDate();

}

if(months<0){

years--;

months+=12;

}

setResult(
"ageResult",
`${years} years, ${months} months, ${days} days`,
"success"
);

}


