
*{
box-sizing:border-box;
margin:0;
padding:0;
}

:root{

--bg:#070912;
--panel:#0d111d;
--panel2:#111827;
--text:#f8fafc;
--muted:#8791a5;

--primary:#7c5cff;
--primary2:#00d4ff;

--border:rgba(255,255,255,.07);

--shadow:
0 20px 60px rgba(0,0,0,.25);

}

body{

font-family:
Inter,
Segoe UI,
Arial,
sans-serif;

background:

radial-gradient(
circle at 10% 0%,
rgba(124,92,255,.15),
transparent 30%
),

radial-gradient(
circle at 100% 20%,
rgba(0,212,255,.10),
transparent 30%
),

var(--bg);

color:var(--text);

min-height:100vh;

overflow-x:hidden;

}


/* =========================
APP
========================= */

.app{

display:flex;

min-height:100vh;

}


/* =========================
SIDEBAR
========================= */

.sidebar{

width:250px;

position:fixed;

left:0;
top:0;
bottom:0;

padding:25px 16px;

background:
rgba(10,13,23,.9);

border-right:
1px solid var(--border);

backdrop-filter:blur(20px);

display:flex;
flex-direction:column;

z-index:50;

}

.brand{

display:flex;

align-items:center;

gap:12px;

padding:10px;

margin-bottom:40px;

}

.brand-logo{

width:43px;
height:43px;

display:flex;
align-items:center;
justify-content:center;

border-radius:13px;

font-size:22px;
font-weight:900;

background:
linear-gradient(
135deg,
var(--primary),
var(--primary2)
);

box-shadow:
0 8px 30px
rgba(124,92,255,.25);

}

.brand strong{

display:block;

font-size:16px;

}

.brand span{

display:block;

font-size:11px;

color:var(--muted);

margin-top:3px;

}


nav{

display:flex;
flex-direction:column;

gap:7px;

}

.nav-item{

width:100%;

border:0;

background:transparent;

color:var(--muted);

padding:13px 14px;

border-radius:12px;

display:flex;

align-items:center;

gap:12px;

font-size:14px;

cursor:pointer;

text-align:left;

transition:.2s;

}

.nav-item span{

font-size:18px;

}

.nav-item:hover{

background:rgba(255,255,255,.04);

color:var(--text);

}

.nav-item.active{

background:
linear-gradient(
90deg,
rgba(124,92,255,.16),
rgba(0,212,255,.05)
);

color:white;

}


.sidebar-bottom{

margin-top:auto;

display:flex;

align-items:center;

justify-content:space-between;

padding:10px;

}

.side-info span{

display:block;

font-size:12px;

font-weight:bold;

}

.side-info small{

color:var(--muted);

font-size:10px;

}

.theme-button{

width:40px;
height:40px;

border-radius:11px;

border:1px solid var(--border);

background:var(--panel);

color:white;

cursor:pointer;

}


/* =========================
MAIN
========================= */

.main{

margin-left:250px;

width:calc(100% - 250px);

}


/* =========================
TOPBAR
========================= */

.topbar{

height:78px;

padding:0 35px;

display:flex;

align-items:center;

justify-content:space-between;

border-bottom:1px solid var(--border);

background:
rgba(7,9,18,.7);

backdrop-filter:blur(20px);

position:sticky;

top:0;

z-index:30;

}

.page-title{

display:flex;

align-items:center;

gap:12px;

}

.page-title>span{

width:39px;
height:39px;

display:flex;
align-items:center;
justify-content:center;

border-radius:11px;

background:var(--panel2);

}

.page-title h2{

font-size:17px;

}

.page-title p{

font-size:11px;

color:var(--muted);

margin-top:3px;

}

.top-actions{

display:flex;

align-items:center;

gap:10px;

}

.mini-search{

width:260px;

height:40px;

display:flex;

align-items:center;

gap:9px;

padding:0 13px;

border:1px solid var(--border);

border-radius:11px;

background:var(--panel);

}

.mini-search input{

width:100%;

border:0;
outline:0;

background:none;

color:white;

font-size:13px;

}

.icon-button{

width:40px;
height:40px;

border:1px solid var(--border);

border-radius:11px;

background:var(--panel);

color:white;

cursor:pointer;

}

.mobile-menu{

display:none;

}


/* =========================
CONTENT
========================= */

.content{

width:min(1200px,94%);

margin:auto;

padding:35px 0 80px;

}


/* =========================
HERO
========================= */

.hero-card{

min-height:330px;

position:relative;

overflow:hidden;

border:1px solid var(--border);

border-radius:25px;

background:

linear-gradient(
135deg,
rgba(124,92,255,.15),
rgba(0,212,255,.04)
),

var(--panel);

box-shadow:var(--shadow);

padding:50px;

}

.status{

display:inline-flex;

align-items:center;

gap:8px;

font-size:10px;

letter-spacing:1.5px;

color:#aeb6c8;

margin-bottom:20px;

}

.status span{

width:7px;
height:7px;

border-radius:50%;

background:#48e08b;

box-shadow:
0 0 12px #48e08b;

}

.hero-content{

position:relative;

z-index:3;

max-width:600px;

}

.hero h1{

font-size:
clamp(40px,6vw,68px);

line-height:1.02;

letter-spacing:-3px;

}

.hero h1 span{

background:
linear-gradient(
90deg,
var(--primary),
var(--secondary)
);

-webkit-background-clip:text;

color:transparent;

}

.hero p{

max-width:550px;

color:var(--muted);

line-height:1.7;

font-size:14px;

margin:20px 0 25px;

}

.hero-buttons{

display:flex;

gap:10px;

}

.primary-button,
.secondary-button{

padding:12px 18px;

border-radius:11px;

font-weight:bold;

cursor:pointer;

}

.primary-button{

border:0;

color:white;

background:
linear-gradient(
90deg,
var(--primary),
var(--primary2)
);

}

.secondary-button{

border:1px solid var(--border);

background:rgba(255,255,255,.04);

color:white;

}

.hero-decoration{

position:absolute;

right:-70px;
top:-70px;

width:500px;
height:500px;

}

.orb{

position:absolute;

border-radius:50%;

filter:blur(2px);

}

.orb-one{

width:330px;
height:330px;

right:20px;
top:40px;

background:
radial-gradient(
circle,
rgba(124,92,255,.25),
transparent 65%
);

}

.orb-two{

width:260px;
height:260px;

right:130px;
top:150px;

background:
radial-gradient(
circle,
rgba(0,212,255,.18),
transparent 65%
);

}

.floating-card{

position:absolute;

width:75px;
height:75px;

display:flex;
align-items:center;
justify-content:center;

border:1px solid var(--border);

border-radius:20px;

background:
rgba(20,25,40,.8);

backdrop-filter:blur(15px);

font-size:30px;

box-shadow:var(--shadow);

animation:float 4s ease-in-out infinite;

}

.fc-one{

right:100px;
top:90px;

}

.fc-two{

right:260px;
top:180px;

animation-delay:1s;

}

.fc-three{

right:120px;
top:280px;

animation-delay:2s;

}

@keyframes float{

0%,100%{
transform:translateY(0);
}

50%{
transform:translateY(-12px);
}

}


/* =========================
STATS
========================= */

.stats-grid{

display:grid;

grid-template-columns:
repeat(4,1fr);

gap:13px;

margin:18px 0 45px;

}

.stat-card{

padding:18px;

border:1px solid var(--border);

border-radius:16px;

background:var(--panel);

display:flex;

align-items:center;

gap:14px;

}

.stat-icon{

width:42px;
height:42px;

display:flex;
align-items:center;
justify-content:center;

border-radius:12px;

background:rgba(124,92,255,.1);

font-size:19px;

}

.stat-card strong{

display:block;

font-size:20px;

}

.stat-card span{

font-size:11px;

color:var(--muted);

}


/* =========================
CATEGORIES
========================= */

.category{

margin-bottom:42px;

}

.category-heading{

display:flex;

align-items:center;

justify-content:space-between;

margin-bottom:15px;

}

.category-heading h2{

font-size:18px;

}

.category-heading span{

font-size:11px;

color:var(--muted);

}

.tools{

display:grid;

grid-template-columns:
repeat(auto-fill,minmax(240px,1fr));

gap:14px;

}


/* =========================
TOOL CARD
========================= */

.tool-card{

position:relative;

padding:21px;

border-radius:17px;

border:1px solid var(--border);

background:

linear-gradient(
145deg,
rgba(255,255,255,.025),
transparent
),

var(--panel);

transition:

transform .25s,
border-color .25s,
box-shadow .25s;

}

.tool-card:hover{

transform:translateY(-5px);

border-color:
rgba(124,92,255,.35);

box-shadow:
0 15px 40px rgba(0,0,0,.18);

}

.tool-top{

display:flex;

align-items:center;

justify-content:space-between;

margin-bottom:16px;

}

.tool-icon{

width:46px;
height:46px;

display:flex;

align-items:center;
justify-content:center;

border-radius:14px;

font-size:23px;

background:
linear-gradient(
135deg,
rgba(124,92,255,.16),
rgba(0,212,255,.08)
);

}

.favorite{

width:32px;
height:32px;

display:flex;
align-items:center;
justify-content:center;

border:1px solid var(--border);

border-radius:9px;

background:rgba(255,255,255,.02);

color:#596274;

cursor:pointer;

}

.favorite.active{

color:#ffd84d;

background:
rgba(255,216,77,.08);

}

.tool-card h3{

font-size:15px;

margin-bottom:8px;

}

.tool-card p{

font-size:12px;

line-height:1.6;

color:var(--muted);

min-height:40px;

}

.open-button{

width:100%;

margin-top:17px;

padding:11px;

border:1px solid var(--border);

border-radius:10px;

background:rgba(255,255,255,.035);

color:white;

font-weight:bold;

font-size:12px;

cursor:pointer;

transition:.2s;

}

.open-button:hover{

background:
linear-gradient(
90deg,
var(--primary),
var(--primary2)
);

border-color:transparent;

}


/* =========================
MODAL
========================= */

.tool-modal{

position:fixed;

inset:0;

z-index:100;

display:flex;

align-items:center;

justify-content:center;

padding:20px;

background:
rgba(0,0,0,.78);

backdrop-filter:blur(12px);

}

.tool-modal.hidden{

display:none;

}

.tool-window{

width:min(850px,100%);

max-height:92vh;

overflow:hidden;

border:1px solid var(--border);

border-radius:22px;

background:var(--panel);

box-shadow:
0 30px 100px rgba(0,0,0,.5);

animation:
modalIn .25s ease;

}

@keyframes modalIn{

from{
opacity:0;
transform:translateY(15px) scale(.98);
}

to{
opacity:1;
transform:none;
}

}

.tool-header{

min-height:72px;

padding:15px 18px;

display:flex;

align-items:center;

justify-content:space-between;

border-bottom:1px solid var(--border);

}

.tool-header-info{

display:flex;

align-items:center;

gap:12px;

}

.tool-title{

font-size:16px;

font-weight:bold;

}

.tool-subtitle{

font-size:11px;

color:var(--muted);

margin-top:3px;

}

.close-tool{

width:40px;
height:40px;

border:1px solid var(--border);

border-radius:10px;

background:var(--panel2);

color:white;

font-size:23px;

cursor:pointer;

}

.tool-body{

padding:25px;

overflow:auto;

max-height:calc(92vh - 72px);

}


/* =========================
TOOL UI
========================= */

.tool-ui{

max-width:760px;

margin:auto;

}

.tool-ui label{

display:block;

font-size:12px;

font-weight:bold;

margin:0 0 8px;

color:#b7bfd0;

}

.tool-ui textarea,
.tool-ui input,
.tool-ui select{

width:100%;

padding:14px;

border-radius:12px;

border:1px solid var(--border);

background:#080b14;

color:white;

outline:none;

font-size:13px;

margin-bottom:14px;

}

.tool-ui textarea{

min-height:230px;

resize:vertical;

line-height:1.6;

}

.tool-ui input:focus,
.tool-ui textarea:focus,
.tool-ui select:focus{

border-color:
rgba(124,92,255,.6);

box-shadow:
0 0 0 3px rgba(124,92,255,.08);

}

.tool-actions{

display:flex;

flex-wrap:wrap;

gap:9px;

}

.tool-actions button{

padding:12px 17px;

border:0;

border-radius:10px;

background:var(--primary);

color:white;

font-weight:bold;

cursor:pointer;

}

.tool-actions button.secondary{

background:rgba(255,255,255,.06);

border:1px solid var(--border);

}

.tool-result{

margin-top:18px;

padding:18px;

border:1px solid var(--border);

border-radius:14px;

background:#080b14;

line-height:1.8;

word-break:break-word;

white-space:pre-wrap;

}

.tool-grid{

display:grid;

grid-template-columns:
repeat(2,1fr);

gap:12px;

}


/* =========================
TOAST
========================= */

.toast{

position:fixed;

right:22px;

bottom:22px;

z-index:300;

display:flex;

align-items:center;

gap:10px;

padding:13px 17px;

border:1px solid var(--border);

border-radius:12px;

background:#121827;

box-shadow:var(--shadow);

transform:
translateY(100px);

opacity:0;

pointer-events:none;

transition:.3s;

font-size:12px;

}

.toast.show{

transform:none;

opacity:1;

}

#toastIcon{

width:23px;
height:23px;

display:flex;
align-items:center;
justify-content:center;

border-radius:7px;

background:rgba(72,224,139,.12);

color:#48e08b;

}


/* =========================
MOBILE NAV
========================= */

.mobile-nav{

display:none;

}


/* =========================
LIGHT MODE
========================= */

body.light{

--bg:#f3f5fa;

--panel:#ffffff;

--panel2:#eef1f7;

--text:#111827;

--muted:#667085;

--border:rgba(0,0,0,.08);

}

body.light .topbar{

background:rgba(243,245,250,.85);

}

body.light .mini-search input,
body.light .tool-ui input,
body.light .tool-ui textarea,
body.light .tool-ui select{

color:#111827;

}

body.light .tool-ui input,
body.light .tool-ui textarea,
body.light .tool-ui select,
body.light .tool-result{

background:#f7f8fb;

}


/* =========================
MOBILE
========================= */

@media(max-width:850px){

.sidebar{

transform:translateX(-100%);

transition:.25s;

}

.sidebar.open{

transform:none;

}

.main{

margin-left:0;

width:100%;

}

.mobile-menu{

display:block;

width:40px;
height:40px;

border:1px solid var(--border);

border-radius:10px;

background:var(--panel);

color:white;

cursor:pointer;

}

.topbar{

padding:0 16px;

}

.page-title{

display:none;

}

.top-actions{

width:100%;

margin-left:10px;

}

.mini-search{

width:100%;

}

.content{

width:92%;

padding-bottom:100px;

}

.hero-card{

padding:32px 25px;

}

.hero-decoration{

opacity:.4;

right:-180px;

}

.stats-grid{

grid-template-columns:
repeat(2,1fr);

}

.mobile-nav{

display:flex;

position:fixed;

left:10px;
right:10px;
bottom:10px;

height:64px;

z-index:90;

border:1px solid var(--border);

border-radius:18px;

background:
rgba(13,17,29,.92);

backdrop-filter:blur(20px);

justify-content:space-around;

}

.mobile-nav button{

flex:1;

border:0;

background:none;

color:var(--muted);

font-size:18px;

display:flex;

flex-direction:column;

align-items:center;

justify-content:center;

gap:3px;

cursor:pointer;

}

.mobile-nav span{

font-size:9px;

}

.tool-grid{

grid-template-columns:1fr;

}

}

@media(max-width:500px){

.hero h1{

font-size:43px;

}

.stats-grid{

grid-template-columns:1fr 1fr;

}

.stat-card{

padding:14px;

}

.stat-icon{

width:36px;
height:36px;

}

.tools{

grid-template-columns:1fr;

}

.tool-body{

padding:18px;

}

}


/* =========================================
   JOO TOOLS V4 — PROFESSIONAL TOOL SYSTEM
========================================= */

.tool-ui{
    width:100%;
    max-width:900px;
    margin:0 auto;
}

.tool-intro{
    padding:0 0 22px;
    border-bottom:1px solid var(--border);
    margin-bottom:24px;
}

.tool-intro h2{
    font-size:24px;
    letter-spacing:-.5px;
    margin-bottom:7px;
}

.tool-intro p{
    color:var(--muted);
    font-size:13px;
    line-height:1.7;
}

.tool-section{
    padding:18px;
    border:1px solid var(--border);
    background:rgba(255,255,255,.018);
    border-radius:16px;
    margin-bottom:14px;
}

.tool-section-title{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:13px;
}

.tool-section-title strong{
    font-size:13px;
}

.tool-section-title span{
    color:var(--muted);
    font-size:10px;
}

.field{
    margin-bottom:15px;
}

.field:last-child{
    margin-bottom:0;
}

.field label{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:8px;
    color:#c8cedb;
    font-size:11px;
    font-weight:700;
}

.field label span{
    color:var(--muted);
    font-weight:400;
}

.tool-ui input,
.tool-ui textarea,
.tool-ui select{
    transition:
        border-color .2s,
        box-shadow .2s,
        background .2s;
}

.tool-ui textarea{
    min-height:260px;
}

.tool-ui input::placeholder,
.tool-ui textarea::placeholder{
    color:#4e586d;
}

.tool-ui input:hover,
.tool-ui textarea:hover,
.tool-ui select:hover{
    border-color:rgba(255,255,255,.13);
}

.tool-ui input:focus,
.tool-ui textarea:focus,
.tool-ui select:focus{
    border-color:rgba(124,92,255,.65);
    box-shadow:
        0 0 0 3px rgba(124,92,255,.08),
        0 10px 30px rgba(0,0,0,.12);
}

.tool-toolbar{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-top:14px;
}

.tool-btn{
    min-height:42px;
    padding:0 16px;
    border-radius:10px;
    border:1px solid transparent;
    color:#fff;
    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--primary2)
        );
    font-size:12px;
    font-weight:800;
    cursor:pointer;
    transition:.2s;
}

.tool-btn:hover{
    transform:translateY(-2px);
    box-shadow:
        0 10px 25px rgba(124,92,255,.2);
}

.tool-btn.secondary{
    background:rgba(255,255,255,.045);
    border-color:var(--border);
}

.tool-btn.danger{
    background:rgba(255,70,90,.08);
    border-color:rgba(255,70,90,.15);
    color:#ff9ba7;
}

.tool-btn.success{
    background:rgba(72,224,139,.09);
    border-color:rgba(72,224,139,.16);
    color:#79e9a5;
}

.result-panel{
    position:relative;
    margin-top:15px;
    border:1px solid var(--border);
    border-radius:15px;
    overflow:hidden;
    background:#080b14;
}

.result-header{
    min-height:45px;
    padding:0 13px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid var(--border);
    background:rgba(255,255,255,.018);
}

.result-header strong{
    font-size:11px;
}

.result-header span{
    color:var(--muted);
    font-size:10px;
}

.result-content{
    min-height:90px;
    padding:17px;
    white-space:pre-wrap;
    word-break:break-word;
    font-size:13px;
    line-height:1.8;
    color:#dce2ee;
}

.result-content.empty{
    color:#515c70;
}

.result-content.success{
    color:#8be9ad;
}

.result-content.error{
    color:#ff9da8;
}

.copy-mini{
    border:1px solid var(--border);
    background:rgba(255,255,255,.04);
    color:#cbd3e3;
    border-radius:7px;
    padding:5px 8px;
    font-size:9px;
    cursor:pointer;
}

.copy-mini:hover{
    background:rgba(255,255,255,.08);
}

.tool-status{
    display:flex;
    align-items:center;
    gap:7px;
    margin-top:12px;
    color:var(--muted);
    font-size:10px;
}

.tool-status-dot{
    width:7px;
    height:7px;
    border-radius:50%;
    background:#48e08b;
    box-shadow:0 0 10px rgba(72,224,139,.5);
}

.tool-stat-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
    margin-top:15px;
}

.tool-stat{
    padding:14px;
    border-radius:13px;
    border:1px solid var(--border);
    background:rgba(255,255,255,.02);
}

.tool-stat span{
    display:block;
    color:var(--muted);
    font-size:9px;
    margin-bottom:6px;
}

.tool-stat strong{
    display:block;
    font-size:18px;
}

.color-preview{
    height:210px;
    border-radius:17px;
    border:1px solid var(--border);
    position:relative;
    overflow:hidden;
    margin-bottom:15px;
}

.color-preview-info{
    position:absolute;
    left:15px;
    right:15px;
    bottom:15px;
    padding:12px;
    border-radius:11px;
    background:rgba(0,0,0,.35);
    backdrop-filter:blur(10px);
    font-size:11px;
    font-weight:800;
}

.palette-grid{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:10px;
}

.palette-color{
    height:145px;
    border-radius:13px;
    display:flex;
    align-items:flex-end;
    padding:9px;
    cursor:pointer;
    border:1px solid rgba(255,255,255,.08);
    transition:.2s;
}

.palette-color:hover{
    transform:translateY(-4px);
}

.palette-color span{
    width:100%;
    padding:7px;
    border-radius:7px;
    background:rgba(0,0,0,.3);
    backdrop-filter:blur(7px);
    text-align:center;
    font-size:9px;
    font-weight:800;
}

.big-result{
    text-align:center;
    padding:35px 15px;
}

.big-result-value{
    font-size:46px;
    line-height:1;
    font-weight:900;
    letter-spacing:-2px;
}

.big-result-label{
    margin-top:9px;
    color:var(--muted);
    font-size:11px;
}

.code-result{
    font-family:
        "SFMono-Regular",
        Consolas,
        monospace;
    font-size:12px;
}

.range-wrap{
    display:flex;
    align-items:center;
    gap:12px;
}

.range-wrap input[type="range"]{
    margin:0;
    padding:0;
    border:0;
    box-shadow:none;
}

.range-value{
    min-width:45px;
    text-align:center;
    padding:7px;
    border-radius:8px;
    background:rgba(255,255,255,.05);
    font-size:11px;
    font-weight:bold;
}

.empty-state{
    padding:50px 20px;
    text-align:center;
    border:1px dashed var(--border);
    border-radius:16px;
}

.empty-state-icon{
    font-size:35px;
    margin-bottom:12px;
}

.empty-state h3{
    font-size:15px;
    margin-bottom:6px;
}

.empty-state p{
    color:var(--muted);
    font-size:11px;
}

.tool-window{
    animation:
        toolWindowIn .22s cubic-bezier(.2,.8,.2,1);
}

@keyframes toolWindowIn{
    from{
        opacity:0;
        transform:translateY(25px) scale(.97);
    }
    to{
        opacity:1;
        transform:none;
    }
}

.close-tool:hover{
    background:rgba(255,255,255,.07);
}

.tool-card{
    animation:
        cardIn .35s ease both;
}

@keyframes cardIn{
    from{
        opacity:0;
        transform:translateY(8px);
    }
    to{
        opacity:1;
        transform:none;
    }
}

.tool-card:nth-child(2){
    animation-delay:.03s;
}

.tool-card:nth-child(3){
    animation-delay:.06s;
}

.tool-card:nth-child(4){
    animation-delay:.09s;
}

.tool-card:nth-child(5){
    animation-delay:.12s;
}

@media(max-width:600px){

    .tool-section{
        padding:14px;
    }

    .tool-intro h2{
        font-size:20px;
    }

    .tool-stat-grid{
        grid-template-columns:1fr;
    }

    .palette-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .palette-color{
        height:115px;
    }

    .big-result-value{
        font-size:38px;
    }

    .tool-toolbar{
        display:grid;
        grid-template-columns:1fr 1fr;
    }

    .tool-btn{
        width:100%;
    }

}



/* =========================================
   LANGUAGE SWITCHER
========================================= */

.language-btn{

    height:44px;

    min-width:110px;

    padding:0 14px;

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:8px;

    border:1px solid rgba(255,255,255,.10);

    border-radius:12px;

    background:rgba(255,255,255,.045);

    color:inherit;

    font-size:13px;

    font-weight:700;

    cursor:pointer;

    transition:
        transform .2s ease,
        background .2s ease,
        border-color .2s ease,
        box-shadow .2s ease;

    backdrop-filter:blur(14px);

    -webkit-backdrop-filter:blur(14px);

}

.language-btn:hover{

    transform:translateY(-2px);

    background:rgba(255,255,255,.09);

    border-color:rgba(124,92,255,.55);

    box-shadow:
        0 8px 25px rgba(0,0,0,.20);

}

.language-btn:active{

    transform:scale(.96);

}

.language-globe{

    font-size:18px;

    line-height:1;

}

#languageText{

    white-space:nowrap;

}


/* Header controls */

.search-area,
.header-actions,
.top-actions{

    display:flex;

    align-items:center;

    gap:10px;

}


/* RTL support */

html[dir="rtl"] .tool-card{

    text-align:right;

}

html[dir="rtl"] .category-heading{

    flex-direction:row-reverse;

}

html[dir="rtl"] .tool-top{

    flex-direction:row-reverse;

}

html[dir="rtl"] .tool-toolbar{

    direction:rtl;

}

html[dir="rtl"] .result-header{

    flex-direction:row-reverse;

}

html[dir="rtl"] .tool-grid{

    direction:rtl;

}


/* Mobile */

@media(max-width:850px){

    .language-btn{

        min-width:48px;

        width:48px;

        padding:0;

    }

    #languageText{

        display:none;

    }

    .language-globe{

        font-size:19px;

    }

}



/* =========================================
   JOO TOOLS - LANGUAGE SWITCHER PRO
========================================= */

.language-btn{

    position:relative !important;

    order:20;

    flex:0 0 auto;

    height:42px;

    min-width:96px;

    padding:0 13px;

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:7px;

    border:1px solid rgba(255,255,255,.10);

    border-radius:12px;

    background:rgba(255,255,255,.055);

    color:inherit;

    font-family:inherit;

    font-size:13px;

    font-weight:700;

    cursor:pointer;

    transition:
        .2s ease;

    white-space:nowrap;

    backdrop-filter:blur(14px);

    -webkit-backdrop-filter:blur(14px);

}

.language-btn:hover{

    transform:translateY(-2px);

    border-color:rgba(124,92,255,.65);

    background:rgba(124,92,255,.12);

    box-shadow:
        0 8px 25px rgba(0,0,0,.20);

}

.language-btn:active{

    transform:scale(.96);

}

.language-globe{

    font-size:17px;

    line-height:1;

}

#languageText{

    line-height:1;

}


/* خلي عناصر الهيدر كلها في صف واحد */

header,
.topbar,
.top-bar,
.header,
.header-content,
.header-actions,
.top-actions,
.search-area{

    align-items:center;

}


/* دعم اتجاه العربية */

html[dir="rtl"] .language-btn{

    direction:rtl;

}

html[dir="rtl"] .tool-card{

    text-align:right;

}

html[dir="rtl"] .tool-top{

    direction:rtl;

}

html[dir="rtl"] .category-heading{

    direction:rtl;

}

html[dir="rtl"] .result-header{

    direction:rtl;

}

html[dir="rtl"] textarea,
html[dir="rtl"] input,
html[dir="rtl"] select{

    text-align:right;

    direction:rtl;

}


/* واجهة الأدوات */

.joo-arabic .tool-intro{

    text-align:right;

}

.joo-arabic .field label{

    text-align:right;

}

.joo-arabic .tool-status{

    direction:rtl;

}


/* الموبايل */

@media(max-width:850px){

    .language-btn{

        width:44px;

        min-width:44px;

        height:42px;

        padding:0;

        border-radius:11px;

    }

    #languageText{

        display:none;

    }

    .language-globe{

        font-size:18px;

    }

}

@media(max-width:520px){

    .language-btn{

        width:40px;

        min-width:40px;

        height:40px;

    }

}


/* JOO TOOLS LANGUAGE BUTTON */

#languageBtn.language-btn{

    display:inline-flex !important;

    align-items:center;

    justify-content:center;

    gap:7px;

    height:42px;

    min-width:96px;

    padding:0 13px;

    margin:0 6px;

    border:1px solid rgba(255,255,255,.12);

    border-radius:12px;

    background:rgba(255,255,255,.06);

    color:inherit;

    font-family:inherit;

    font-size:13px;

    font-weight:700;

    cursor:pointer;

    white-space:nowrap;

    position:relative;

    z-index:9999;

    transition:all .2s ease;

}

#languageBtn.language-btn:hover{

    transform:translateY(-2px);

    border-color:rgba(124,92,255,.7);

    background:rgba(124,92,255,.14);

}

#languageBtn .language-globe{

    font-size:18px;

}

@media(max-width:850px){

    #languageBtn.language-btn{

        min-width:42px;

        width:42px;

        padding:0;

        margin:0 3px;

    }

    #languageBtn #languageText{

        display:none;

    }

}


/* =========================================
   TOPBAR - JOO TOOLS
========================================= */

.topbar{
    display:flex;
    align-items:center;
    gap:12px;
}

.topbar .mini-search{
    flex:1;
    min-width:120px;
}

.topbar #languageBtn{
    flex:0 0 auto;
    order:2;
}

.topbar #themeBtn{
    flex:0 0 auto;
    order:3;
}

.topbar #languageBtn,
.topbar #themeBtn{
    height:44px;
}

/* RTL */
html[dir="rtl"] .topbar{
    direction:rtl;
}

/* Mobile */
@media(max-width:700px){

    .topbar{
        gap:7px;
    }

    .topbar #languageBtn{
        min-width:44px;
        width:44px;
        padding:0;
    }

    .topbar #languageBtn #languageText{
        display:none;
    }

    .topbar .mini-search{
        min-width:0;
    }

}

/* =========================================
   JOO TOOLS - TOAST NOTIFICATIONS
========================================= */

#jooToastContainer{

    position:fixed;

    right:22px;

    bottom:22px;

    z-index:999999;

    display:flex;

    flex-direction:column;

    gap:10px;

    pointer-events:none;

}

.joo-toast{

    min-width:260px;

    max-width:360px;

    padding:14px 17px;

    display:flex;

    align-items:center;

    gap:11px;

    border:1px solid rgba(255,255,255,.12);

    border-radius:14px;

    background:rgba(20,20,28,.92);

    color:#fff;

    box-shadow:
        0 15px 45px rgba(0,0,0,.35);

    backdrop-filter:blur(18px);

    -webkit-backdrop-filter:blur(18px);

    animation:
        jooToastIn .3s ease forwards;

    pointer-events:auto;

}

.joo-toast-icon{

    width:30px;

    height:30px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:9px;

    background:rgba(255,255,255,.08);

    font-size:16px;

    flex:0 0 auto;

}

.joo-toast-text{

    font-size:13px;

    font-weight:600;

    line-height:1.4;

}

.joo-toast.hide{

    animation:
        jooToastOut .3s ease forwards;

}

@keyframes jooToastIn{

    from{

        opacity:0;

        transform:
            translateY(15px)
            scale(.96);

    }

    to{

        opacity:1;

        transform:
            translateY(0)
            scale(1);

    }

}

@keyframes jooToastOut{

    from{

        opacity:1;

        transform:
            translateY(0)
            scale(1);

    }

    to{

        opacity:0;

        transform:
            translateY(15px)
            scale(.96);

    }

}

html[dir="rtl"] #jooToastContainer{

    right:auto;

    left:22px;

}

@media(max-width:600px){

    #jooToastContainer{

        left:12px;

        right:12px;

        bottom:12px;

    }

    .joo-toast{

        min-width:0;

        width:100%;

        max-width:none;

    }

}


/* =========================================
   JOO TOOLS — TOOL WORKSPACE PRO
========================================= */

.tool-workspace{

    width:100%;
    max-width:1000px;
    margin:0 auto;
    padding:28px;

    border:1px solid rgba(255,255,255,.10);
    border-radius:24px;

    background:rgba(255,255,255,.035);

    box-shadow:
        0 20px 70px rgba(0,0,0,.20);

    backdrop-filter:blur(20px);
    -webkit-backdrop-filter:blur(20px);

    animation:jooWorkspaceIn .35s ease;

}

.tool-workspace-header{

    display:flex;
    align-items:center;
    gap:18px;
    margin-bottom:28px;

}

.tool-workspace-icon{

    width:64px;
    height:64px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:18px;

    background:rgba(124,92,255,.12);

    border:1px solid rgba(124,92,255,.25);

    font-size:30px;

    flex:0 0 auto;

}

.tool-workspace-title{

    flex:1;

}

.tool-workspace-title h1{

    margin:0 0 6px;

    font-size:25px;

}

.tool-workspace-title p{

    margin:0;

    opacity:.65;

    line-height:1.6;

    font-size:14px;

}

.tool-back{

    height:42px;

    padding:0 15px;

    border-radius:11px;

    border:1px solid rgba(255,255,255,.10);

    background:rgba(255,255,255,.05);

    color:inherit;

    cursor:pointer;

    font-weight:700;

    transition:.2s ease;

}

.tool-back:hover{

    transform:translateY(-2px);

    background:rgba(255,255,255,.09);

}

.tool-panel{

    padding:22px;

    border-radius:18px;

    background:rgba(0,0,0,.12);

    border:1px solid rgba(255,255,255,.07);

}

.tool-field{

    margin-bottom:18px;

}

.tool-field label{

    display:block;

    margin-bottom:8px;

    font-size:13px;

    font-weight:700;

    opacity:.8;

}

.tool-field input,
.tool-field textarea,
.tool-field select{

    width:100%;

    box-sizing:border-box;

    padding:13px 14px;

    border-radius:12px;

    border:1px solid rgba(255,255,255,.10);

    background:rgba(255,255,255,.045);

    color:inherit;

    outline:none;

    font:inherit;

    transition:.2s ease;

}

.tool-field textarea{

    min-height:150px;

    resize:vertical;

}

.tool-field input:focus,
.tool-field textarea:focus,
.tool-field select:focus{

    border-color:rgba(124,92,255,.65);

    box-shadow:
        0 0 0 3px rgba(124,92,255,.10);

}

.tool-actions{

    display:flex;

    flex-wrap:wrap;

    gap:10px;

    margin-top:20px;

}

.tool-btn{

    min-height:44px;

    padding:0 17px;

    border-radius:12px;

    border:1px solid rgba(255,255,255,.10);

    background:rgba(255,255,255,.06);

    color:inherit;

    cursor:pointer;

    font:inherit;

    font-weight:700;

    transition:.2s ease;

}

.tool-btn:hover{

    transform:translateY(-2px);

    background:rgba(255,255,255,.10);

}

.tool-btn.primary{

    background:rgba(124,92,255,.85);

    border-color:rgba(124,92,255,.9);

    color:#fff;

}

.tool-btn.primary:hover{

    background:rgba(124,92,255,1);

    box-shadow:
        0 10px 30px rgba(124,92,255,.20);

}

.tool-result{

    margin-top:20px;

    padding:18px;

    min-height:60px;

    border-radius:15px;

    border:1px solid rgba(255,255,255,.08);

    background:rgba(255,255,255,.035);

    overflow:auto;

    white-space:pre-wrap;

    word-break:break-word;

}

.tool-result-header{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:10px;

    margin-bottom:10px;

}

.tool-result-title{

    font-size:13px;

    font-weight:800;

    opacity:.7;

}

.tool-copy{

    padding:7px 11px;

    border-radius:9px;

    border:1px solid rgba(255,255,255,.10);

    background:rgba(255,255,255,.05);

    color:inherit;

    cursor:pointer;

    font-size:12px;

    font-weight:700;

}

@keyframes jooWorkspaceIn{

    from{

        opacity:0;

        transform:translateY(12px);

    }

    to{

        opacity:1;

        transform:translateY(0);

    }

}

@media(max-width:700px){

    .tool-workspace{

        padding:17px;

        border-radius:18px;

    }

    .tool-workspace-header{

        align-items:flex-start;

        flex-wrap:wrap;

    }

    .tool-workspace-icon{

        width:52px;
        height:52px;
        font-size:24px;

    }

    .tool-workspace-title h1{

        font-size:21px;

    }

    .tool-back{

        width:100%;

    }

    .tool-panel{

        padding:15px;

    }

}


/* =========================================
   JOO TOOLS — MAIN BRAND
========================================= */

.joo-main-brand{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:10px;

    margin:0 auto;

    font-size:clamp(38px,7vw,76px);

    font-weight:950;

    letter-spacing:-3px;

    line-height:1.05;

    background:linear-gradient(
        135deg,
        #ffffff 0%,
        #d8d8ff 35%,
        #8f7cff 65%,
        #ffffff 100%
    );

    -webkit-background-clip:text;
    background-clip:text;

    -webkit-text-fill-color:transparent;

    text-shadow:
        0 0 35px rgba(124,92,255,.18);

    user-select:none;

    animation:jooBrandIn .7s ease both;

}

.joo-main-brand .joo-brand-fire{

    -webkit-text-fill-color:initial;

    filter:
        drop-shadow(
            0 0 12px rgba(255,120,30,.35)
        );

}

.joo-main-brand .joo-brand-tools{

    -webkit-text-fill-color:initial;

    filter:
        drop-shadow(
            0 0 12px rgba(180,180,180,.3)
        );

}

@keyframes jooBrandIn{

    from{

        opacity:0;

        transform:
            translateY(15px)
            scale(.96);

    }

    to{

        opacity:1;

        transform:
            translateY(0)
            scale(1);

    }

}

.joo-main-brand:hover{

    transform:scale(1.025);

    transition:.25s ease;

}


/* =========================================
   JOO TOOLS PRO TOOL SYSTEM
========================================= */

.jt-pro-tool {
    width: 100%;
    max-width: 920px;
    margin: auto;
    padding: 26px;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 24px;
    background: rgba(255,255,255,.035);
    backdrop-filter: blur(18px);
    box-shadow: 0 25px 70px rgba(0,0,0,.22);
}

.jt-tool-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
}

.jt-tool-symbol {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    border-radius: 17px;
    background: rgba(255,255,255,.07);
    font-size: 28px;
}

.jt-tool-head h2 {
    margin: 0 0 5px;
    font-size: 25px;
}

.jt-tool-head p {
    margin: 0;
    opacity: .62;
}

.jt-upload {
    min-height: 190px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px dashed rgba(255,255,255,.18);
    border-radius: 20px;
    cursor: pointer;
    transition: .25s ease;
    text-align: center;
}

.jt-upload:hover,
.jt-upload.drag-active {
    transform: translateY(-2px);
    border-color: rgba(255,255,255,.42);
    background: rgba(255,255,255,.045);
}

.jt-upload-icon {
    font-size: 42px;
    margin-bottom: 5px;
}

.jt-upload span {
    opacity: .55;
    font-size: 14px;
}

.jt-image-preview {
    margin: 22px 0;
    min-height: 220px;
    max-height: 460px;
    display: grid;
    place-items: center;
    padding: 16px;
    border-radius: 18px;
    background: rgba(0,0,0,.18);
    overflow: hidden;
}

.jt-image-preview img {
    max-width: 100%;
    max-height: 420px;
    object-fit: contain;
    border-radius: 12px;
}

.jt-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 15px;
}

.jt-pro-tool label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 15px;
    font-weight: 600;
}

.jt-pro-tool input,
.jt-pro-tool select {
    width: 100%;
    box-sizing: border-box;
    padding: 13px 14px;
    border-radius: 13px;
    border: 1px solid rgba(255,255,255,.1);
    background: rgba(255,255,255,.055);
    color: inherit;
    outline: none;
}

.jt-pro-tool input:focus,
.jt-pro-tool select:focus {
    border-color: rgba(255,255,255,.35);
}

.jt-check {
    flex-direction: row !important;
    align-items: center;
    gap: 10px !important;
    font-weight: 500 !important;
}

.jt-check input {
    width: auto;
}

.jt-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
}

.jt-actions button {
    border: 0;
    border-radius: 13px;
    padding: 13px 18px;
    cursor: pointer;
    font-weight: 800;
    transition: .2s ease;
}

.jt-actions button:hover:not(:disabled) {
    transform: translateY(-2px);
}

.jt-actions button:disabled {
    opacity: .4;
    cursor: not-allowed;
}

.jt-primary {
    background: #fff;
    color: #111;
}

.jt-secondary {
    background: rgba(255,255,255,.07);
    color: inherit;
    border: 1px solid rgba(255,255,255,.1) !important;
}

.jt-result {
    min-height: 22px;
    margin-top: 16px;
    opacity: .7;
    font-size: 14px;
}

@media (max-width: 650px) {
    .jt-pro-tool {
        padding: 18px;
        border-radius: 18px;
    }

    .jt-grid-2 {
        grid-template-columns: 1fr;
    }

    .jt-actions button {
        width: 100%;
    }
}

