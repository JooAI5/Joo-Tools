document.getElementById(
"toBase"
).value
);

const decimal =
parseInt(
value,
from
);

if(
isNaN(decimal) ||
from<2 ||
from>36 ||
to<2 ||
to>36
){

setResult(
"baseResult",
"Invalid number or base.",
"error"
);

return;

}

setResult(
"baseResult",
decimal
.toString(to)
.toUpperCase(),
"success"
);

}


