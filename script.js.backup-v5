Your random number
</div>

</div>

</div>

`;

}


function chooseRandom(){

const values =
document.getElementById(
"choices"
)
.value
.split("\n")
.map(x=>x.trim())
.filter(Boolean);

if(!values.length){

showToast(
"Enter some choices",
"!"
);

return;

}

setResult(
"choiceResult",
values[
Math.floor(
Math.random()*values.length
)
],
"success"
);

}


