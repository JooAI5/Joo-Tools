const translations = {

en: {
    allTools: "All Tools",
    favorites: "Favorites",
    recent: "Recent",
    everything: "Everything you need in one place",
    yourSaved: "Your saved tools",
    recentlyUsed: "Your recently used tools",
    searchPlaceholder: "Search tools...",
    tools: "tools",
    open: "Open Tool →",
    noFavorites: "No favorites yet",
    noFavoritesText: "Tap the star on any tool to save it here.",
    noRecent: "No recent tools",
    noRecentText: "Tools you use will appear here.",
    language: "العربية"
},

ar: {
    allTools: "كل الأدوات",
    favorites: "المفضلة",
    recent: "الأخيرة",
    everything: "كل ما تحتاجه في مكان واحد",
    yourSaved: "الأدوات المحفوظة لديك",
    recentlyUsed: "الأدوات التي استخدمتها مؤخرًا",
    searchPlaceholder: "ابحث عن أداة...",
    tools: "أدوات",
    open: "فتح الأداة ←",
    noFavorites: "لا توجد أدوات مفضلة",
    noFavoritesText: "اضغط على النجمة بجانب أي أداة لإضافتها هنا.",
    noRecent: "لا توجد أدوات حديثة",
    noRecentText: "الأدوات التي تستخدمها ستظهر هنا."
}

};

let currentLanguage =
localStorage.getItem("jooLanguage") || "en";


function createLanguageSwitcher(){

    if(document.getElementById("languageBtn"))
        return;

    const searchElement =
        document.getElementById("search");

    const themeButton =
        document.getElementById("themeBtn");

    const button =
        document.createElement("button");

    button.id = "languageBtn";

    button.className = "language-btn";

    button.type = "button";

    button.innerHTML = `
        <span class="language-globe">🌐</span>
        <span id="languageText">
            ${currentLanguage === "en" ? "العربية" : "English"}
        </span>
    `;

    button.title = "Change Language";

    button.addEventListener(
        "click",
        toggleLanguage
    );

    if(searchElement){

        searchElement.parentNode.insertBefore(
            button,
            searchElement.nextSibling
        );

    }else if(themeButton){

        themeButton.parentNode.insertBefore(
            button,
            themeButton
        );

    }else{

        document.body.appendChild(button);

    }

}


function toggleLanguage(){

    currentLanguage =
        currentLanguage === "en"
        ? "ar"
        : "en";

    localStorage.setItem(
        "jooLanguage",
        currentLanguage
    );

    applyLanguage();

}


function applyLanguage(){

    const t =
        translations[currentLanguage];

    document.documentElement.lang =
        currentLanguage;

    document.documentElement.dir =
        currentLanguage === "ar"
        ? "rtl"
        : "ltr";

    const languageText =
        document.getElementById(
            "languageText"
        );

    if(languageText){

        languageText.textContent =
            currentLanguage === "en"
            ? "العربية"
            : "English";

    }

    if(search){

        search.placeholder =
            t.searchPlaceholder;

    }

    updateStaticTexts();

    render();

}


function updateStaticTexts(){

    const t =
        translations[currentLanguage];

    const pageTitle =
        document.getElementById("pageTitle");

    const pageSubtitle =
        document.getElementById("pageSubtitle");

    if(
        pageTitle &&
        (
            pageTitle.textContent === "All Tools" ||
            pageTitle.textContent === "كل الأدوات"
        )
    ){

        pageTitle.textContent =
            t.allTools;

    }

    if(
        pageSubtitle &&
        (
            pageSubtitle.textContent ===
                "Everything you need in one place" ||
            pageSubtitle.textContent ===
                "كل ما تحتاجه في مكان واحد"
        )
    ){

        pageSubtitle.textContent =
            t.everything;

    }

}


const originalToolCard =
toolCard;

toolCard = function(tool){

    const t =
        translations[currentLanguage];

    const active =
        favorites.includes(tool.id)
        ? "active"
        : "";

    const name =
        tool.name;

    const description =
        tool.description;

    return `

    <article class="tool-card">

        <div class="tool-top">

            <div class="tool-icon">
                ${tool.icon}
            </div>

            <button
                class="favorite ${active}"
                onclick="toggleFavorite('${tool.id}',event)"
                aria-label="Favorite">

                ★

            </button>

        </div>

        <h3>
            ${name}
        </h3>

        <p>
            ${description}
        </p>

        <button
            class="open-button"
            onclick="openTool('${tool.id}')">

            ${t.open}

        </button>

    </article>

    `;

};


const originalRender =
render;

render = function(list=tools){

    sections.innerHTML="";

    const grouped={};

    list.forEach(tool=>{

        if(!grouped[tool.category])
            grouped[tool.category]=[];

        grouped[tool.category].push(tool);

    });

    Object.entries(grouped).forEach(
        ([category,list])=>{

            const section =
                document.createElement("section");

            section.className =
                "category";

            const t =
                translations[currentLanguage];

            section.innerHTML = `

                <div class="category-heading">

                    <h2>
                        ${category}
                    </h2>

                    <span>
                        ${list.length}
                        ${t.tools}
                    </span>

                </div>

                <div class="tools">

                    ${list.map(toolCard).join("")}

                </div>

            `;

            sections.appendChild(section);

        }
    );

    updateStats();

};


const originalGoHome =
goHome;

goHome = function(){

    document.getElementById("pageTitle")
        .textContent =
        translations[currentLanguage].allTools;

    document.getElementById("pageSubtitle")
        .textContent =
        translations[currentLanguage].everything;

    document.getElementById("pageIcon")
        .textContent="⌂";

    search.value="";

    render();

};


const originalShowFavorites =
showFavorites;

showFavorites = function(){

    const t =
        translations[currentLanguage];

    const list =
        tools.filter(
            x=>favorites.includes(x.id)
        );

    document.getElementById("pageTitle")
        .textContent =
        t.favorites;

    document.getElementById("pageSubtitle")
        .textContent =
        t.yourSaved;

    document.getElementById("pageIcon")
        .textContent="★";

    if(!list.length){

        sections.innerHTML = `

        <div class="empty-state">

            <div class="empty-state-icon">
                ★
            </div>

            <h3>
                ${t.noFavorites}
            </h3>

            <p>
                ${t.noFavoritesText}
            </p>

        </div>

        `;

        updateStats();

        return;

    }

    render(list);

};


const originalShowRecent =
showRecent;

showRecent = function(){

    const t =
        translations[currentLanguage];

    const list =
        recent
        .map(id=>tools.find(x=>x.id===id))
        .filter(Boolean);

    document.getElementById("pageTitle")
        .textContent =
        t.recent;

    document.getElementById("pageSubtitle")
        .textContent =
        t.recentlyUsed;

    document.getElementById("pageIcon")
        .textContent="◷";

    if(!list.length){

        sections.innerHTML = `

        <div class="empty-state">

            <div class="empty-state-icon">
                ◷
            </div>

            <h3>
                ${t.noRecent}
            </h3>

            <p>
                ${t.noRecentText}
            </p>

        </div>

        `;

        updateStats();

        return;

    }

    render(list);

};


document.addEventListener(
    "DOMContentLoaded",
    ()=>{

        createLanguageSwitcher();

        applyLanguage();

    }
);


/* In case script loads after DOM */
if(document.readyState !== "loading"){

    createLanguageSwitcher();

    applyLanguage();

}

