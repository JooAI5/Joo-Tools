</button>

</div>

</div>

${resultPanel(
"ageResult",
"Your Age"
)}

`;

}


let stopwatchTimer=null;
let stopwatchSeconds=0;

function startStopwatch(){

if(stopwatchTimer)
return;

stopwatchTimer =
setInterval(()=>{

stopwatchSeconds++;

const h =
Math.floor(
stopwatchSeconds/3600
);

const m =
Math.floor(
(stopwatchSeconds%3600)/60
);

const s =
stopwatchSeconds%60;

const display =
document.getElementById(
"stopwatchDisplay"
);

if(display){

display.textContent =
`${String(h).padStart(2,"0")}:`+
`${String(m).padStart(2,"0")}:`+
`${String(s).padStart(2,"0")}`;

}

},1000);

}


function pauseStopwatch(){

clearInterval(
stopwatchTimer
);

stopwatchTimer=null;

}


function resetStopwatch(){

pauseStopwatch();

stopwatchSeconds=0;

const display =
document.getElementById(
"stopwatchDisplay"
);

if(display)
display.textContent=
"00:00:00";

}


