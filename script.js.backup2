function encodeBase64(){

const text =
document.getElementById(
"base64Input"
).value;

const bytes =
new TextEncoder()
.encode(text);

let binary="";

bytes.forEach(
b=>binary+=
String.fromCharCode(b)
);

setResult(
"base64Result",
btoa(binary),
"success"
);

}


function decodeBase64(){

try{

const binary =
atob(
document.getElementById(
"base64Input"
).value
);

const bytes =
Uint8Array.from(
binary,
x=>x.charCodeAt(0)
);

setResult(
"base64Result",
new TextDecoder()
.decode(bytes),
"success"
);

}catch{

setResult(
"base64Result",
"Invalid Base64.",
"error"
);

}

}


